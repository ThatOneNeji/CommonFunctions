{
    "tags": {
        "allowUnknownTags": true
    },
    "source": {
        "include": "./lib",
        "includePattern": ".js$",
        "exclude": [
            "node_modules",
            "lib/node_modules",
            "documentation",
            "eslint.config.js"
        ]
    },
    "plugins": [
        "plugins/markdown"
    ],
    "templates": {
        "systemName": "Common Functions",
        "footer": "",
        "copyright": "",
        "includeDate": true,
        "navType": "inline",
        "theme": "slate",
        "linenums": true,
        "collapseSymbols": false,
        "inverseNav": false,
        "dateFormat": "YYYY/MM/DD",
        "cleverLinks": false,
        "monospaceLinks": false,
        "default": {
            "outputSourceFiles": true
        }
    },
    "opts": {
        "template": "./node_modules/ink-docstrap/template",
        "encoding": "utf8",
        "destination": "./documentation/",
        "recurse": true
    }
}
